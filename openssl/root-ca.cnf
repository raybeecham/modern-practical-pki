[ ca ]
default_ca = CA_default

[ CA_default ]
dir               = $ENV::LAB_DIR/root
certs             = $dir/certs
crl_dir           = $dir/crl
new_certs_dir     = $dir/newcerts
database          = $dir/index.txt
serial            = $dir/serial
crlnumber         = $dir/crlnumber
certificate       = $dir/certs/root-ca.crt.pem
private_key       = $dir/private/root-ca.key.pem

default_days      = 3650
default_md        = sha384
preserve          = no
unique_subject    = no
policy            = policy_strict
name_opt          = ca_default
cert_opt          = ca_default
copy_extensions   = none

default_crl_days  = 30
crl_extensions    = crl_ext

[ policy_strict ]
countryName             = match
stateOrProvinceName     = optional
localityName            = optional
organizationName        = match
organizationalUnitName  = optional
commonName              = supplied
emailAddress            = optional

[ req ]
prompt             = no
distinguished_name = root_dn
string_mask        = utf8only
default_md         = sha384
x509_extensions    = root_ca_ext

[ root_dn ]
C  = US
O  = Modern Practical PKI Lab
CN = Modern Practical PKI Root CA

[ root_ca_ext ]
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always,issuer
basicConstraints       = critical,CA:true,pathlen:1
keyUsage               = critical,keyCertSign,cRLSign

[ intermediate_ca_ext ]
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid,issuer
basicConstraints       = critical,CA:true,pathlen:0
keyUsage               = critical,keyCertSign,cRLSign
crlDistributionPoints  = URI:http://localhost:8080/root-ca.crl.pem
authorityInfoAccess    = caIssuers;URI:http://localhost:8080/root-ca.crt.pem

[ crl_ext ]
authorityKeyIdentifier = keyid:always

